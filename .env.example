# Copy to .env and fill in. Loaded by the CLI at startup.

# Hugging Face (required to download gated models / push checkpoints)
HF_TOKEN=

# OpenAI-compatible endpoints (used by the OpenAI / vLLM model runners)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# S3-compatible object storage (used by the S3 artifact store)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Cloud provider credentials (used by the cloud job runner)
RUNPOD_API_KEY=